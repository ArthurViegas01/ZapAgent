# =============================================================================
# ZapAgent — environment variables
# Copy to `.env` for local dev. Never commit `.env`.
# =============================================================================

# -- Runtime ------------------------------------------------------------------
ENVIRONMENT=development            # development | staging | production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
API_HOST=0.0.0.0
API_PORT=8000

# -- Database (Supabase Postgres) --------------------------------------------
# Local dev points at the docker-compose postgres; prod points at Supabase.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=zapagent
POSTGRES_USER=zapagent
POSTGRES_PASSWORD=zapagent_local_dev
DATABASE_URL=postgresql+psycopg://zapagent:zapagent_local_dev@postgres:5432/zapagent
# Sync URL (for Alembic / psql); the async URL above is for SQLAlchemy.
DATABASE_URL_SYNC=postgresql://zapagent:zapagent_local_dev@postgres:5432/zapagent

# -- Supabase (dashboard + auth) ---------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=                 # exposed to the browser, dashboard only
SUPABASE_SERVICE_ROLE_KEY=         # server-side only, never ship to browser
SUPABASE_JWT_SECRET=               # used by FastAPI to verify dashboard JWTs

# -- Redis (Celery broker + Evolution cache) ---------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# -- Anthropic (Claude Haiku) ------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=1024

# -- Voyage AI (embeddings) --------------------------------------------------
VOYAGE_API_KEY=                    # https://dash.voyageai.com
VOYAGE_MODEL=voyage-3-lite

# -- Evolution API (WhatsApp) ------------------------------------------------
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=                 # generated on first boot; see Evolution docs
EVOLUTION_WEBHOOK_SECRET=          # HMAC secret we validate on each webhook

# -- Google Calendar (per-tenant OAuth) --------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/integrations/google/callback

# -- Asaas (payments) --------------------------------------------------------
ASAAS_API_KEY=
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_WEBHOOK_TOKEN=

# -- Agent behavior ----------------------------------------------------------
AGENT_CONFIDENCE_THRESHOLD=0.65    # below -> handoff to human
AGENT_RESPONSE_MAX_CHARS=1500
AGENT_RAG_TOP_K=4

# -- Observability -----------------------------------------------------------
SENTRY_DSN=                        # optional
OTEL_EXPORTER_OTLP_ENDPOINT=       # optional

# -- Next.js (apps/web) ------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
